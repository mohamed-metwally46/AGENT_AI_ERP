# ERP AI Agent -- environment configuration.
#
# Copy to `.env` and adjust. `python -m erp_agent --list-settings` prints every
# variable this system reads, and works even when the configuration is invalid.

# --------------------------------------------------------------------------- #
# Process
# --------------------------------------------------------------------------- #
APP_ENV=local
LOG_LEVEL=INFO
LOG_FORMAT=console

# --------------------------------------------------------------------------- #
# ERP database -- READ ONLY
# --------------------------------------------------------------------------- #
# Must name a read-only role. `hr_user` and `postgres` own the schema and are
# refused at startup; any role that can actually write is refused by the write
# barrier probe, which attempts a write of every shape before serving.
#
# The role is created by database/schema/hr/10_readonly_role.sql.
ERP_DATABASE_URL=postgresql://mock_hr_readonly:readonly_password@localhost:5433/mock_hr

ERP_DB_MIN_POOL_SIZE=1
ERP_DB_MAX_POOL_SIZE=5
ERP_DB_CONNECT_TIMEOUT_S=10

# Matches TOOL_TIMEOUT_SECONDS in Plan.md section 5.3.
ERP_DB_STATEMENT_TIMEOUT_MS=15000

# Matches MAX_ROWS_PER_TOOL_RESULT in Plan.md section 5.3.
ERP_DB_MAX_ROWS=100

ERP_DB_APPLICATION_NAME=erp-agent

# --------------------------------------------------------------------------- #
# Principal resolution
# --------------------------------------------------------------------------- #
# YAML fixture standing in for the Platform `users` / `user_roles` tables, which
# mock_hr does not have (Plan.md section 8.5, gap S6). Phase 9 replaces it with
# a real join.
#
# Leave unset to use the fixture packaged with the application at
# src/erp_agent/infrastructure/security/fixtures/principals.dev.yaml.
# ERP_PRINCIPAL_FIXTURE_PATH=/path/to/principals.yaml
