# ERP AI Agent -- environment configuration.
#
# Copy to `.env` and adjust. `python -m erp_agent --list-settings` prints every
# variable this system reads, and works even when the configuration is invalid.

# --------------------------------------------------------------------------- #
# Process
# --------------------------------------------------------------------------- #
APP_ENV=local
LOG_LEVEL=INFO
LOG_FORMAT=console

# --------------------------------------------------------------------------- #
# ERP database -- READ ONLY
# --------------------------------------------------------------------------- #
# Must name a read-only role. `hr_user` and `postgres` own the schema and are
# refused at startup; any role that can actually write is refused by the write
# barrier probe, which attempts a write of every shape before serving.
#
# The role is created by database/schema/hr/10_readonly_role.sql.
ERP_DATABASE_URL=postgresql://mock_hr_readonly:readonly_password@localhost:5433/mock_hr

ERP_DB_MIN_POOL_SIZE=1
ERP_DB_MAX_POOL_SIZE=5
ERP_DB_CONNECT_TIMEOUT_S=10

# Matches TOOL_TIMEOUT_SECONDS in Plan.md section 5.3.
ERP_DB_STATEMENT_TIMEOUT_MS=15000

# Matches MAX_ROWS_PER_TOOL_RESULT in Plan.md section 5.3.
ERP_DB_MAX_ROWS=100

ERP_DB_APPLICATION_NAME=erp-agent

# --------------------------------------------------------------------------- #
# Identity and permissions
# --------------------------------------------------------------------------- #
# The mock identity roster: a YAML file standing in for the Platform `users`,
# `user_roles`, `roles` and `role_permissions` tables, which mock_hr does not
# have (Plan.md section 8.5, gap S6). It defines roles with scopes and
# permission grants, and assigns them to users -- see docs/mock-identity.md for
# the roster and for how an ERPIdentityResolver replaces it.
#
# Leave unset to use the roster packaged with the application at
# src/erp_agent/infrastructure/security/fixtures/identity.dev.yaml.
# ERP_PRINCIPAL_FIXTURE_PATH=/path/to/identity.yaml

# YAML fixture standing in for the Platform's `personal_access_tokens`, which
# the agent is not permitted to read (Plan.md section 4: CRITICAL,
# NO_DIRECT_AI_ACCESS). Replaced at cutover by a call to the Platform.
#
# Leave unset to use the packaged dev credentials at
# src/erp_agent/infrastructure/security/fixtures/access_tokens.dev.yaml.
# ERP_ACCESS_TOKEN_FIXTURE_PATH=/path/to/access_tokens.yaml

# BOTH of the above are REQUIRED when APP_ENV=production. The packaged files are
# development-only: they are committed to this repository, the credentials are
# static and non-expiring, and one roster entry grants organisation scope.
# Start-up refuses them twice over -- once in the composition root when the
# adapter is built, and once unconditionally in run_startup_checks, because a
# cached_property only refuses when something touches it.

# --------------------------------------------------------------------------- #
# Document retrieval
# --------------------------------------------------------------------------- #
# Whether to wire the document tool. `false` serves structured questions only,
# which is coherent when no index exists and better than a seventh tool that
# fails on every call.
#
# RAG keeps its own configuration -- Qdrant URL, collection, embedding model --
# and reads it from this same environment. Re-declaring those here would create
# a second vocabulary for one deployment's settings.
ERP_KNOWLEDGE_ENABLED=true

# The document manifest, which decides each document's audience at ingestion
# (Plan.md gap S4: assign, never infer). Leave unset for the packaged dev
# manifest.
# ERP_DOCUMENT_MANIFEST_PATH=/path/to/documents.yaml

# Functional area stamped on every chunk at ingestion.
# ERP_DOCUMENT_MODULE=HR

# --------------------------------------------------------------------------- #
# HTTP API (Plan.md section 11, Phase 7)
# --------------------------------------------------------------------------- #
# Loopback by default: a service that binds every interface the moment somebody
# runs it is a service that gets exposed by accident.
ERP_API_HOST=127.0.0.1
ERP_API_PORT=8000

ERP_API_REQUEST_TIMEOUT_S=90

# Per *principal*, not per address. Plan.md R6 is exfiltration by aggregation --
# many individually authorised questions reconstructing a restricted whole --
# and one authenticated caller behind one address is exactly that case.
ERP_API_RATE_LIMIT_PER_MINUTE=30
ERP_API_RATE_LIMIT_BURST=5

# A question long enough to fill a context window is a way to bury an injection
# in the middle of one.
ERP_API_MAX_QUESTION_CHARS=2000

# Conversation history. Bounded on both axes: an unbounded history is an
# unbounded prompt, and an unbounded store is a memory leak.
ERP_API_MAX_CONVERSATION_TURNS=6
ERP_API_MAX_CONVERSATIONS=500

# Publishes /openapi.json and /docs.
ERP_API_DOCS_ENABLED=true

# Where RAG's own configuration lives, when it is not already exported into
# this process. A container deployment exports one environment and needs
# nothing here; running the agent from `agent/` locally does, because RAG's
# settings are in ../RAG/.env. Naming the file is not re-declaring its
# contents.
# ERP_RAG_ENV_FILE=../RAG/.env
